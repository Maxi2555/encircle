    <string name="home_tagline">Start Encircle with a shortcut, then select, copy and share text or codes on your screen.</string>
    <string name="home_usage_title">How to use</string>
    <string name="home_usage_1">Tap a word to select it. Tap again to extend to the sentence, then the paragraph.</string>
    <string name="home_usage_2">Long-press to select the whole paragraph.</string>
    <string name="home_usage_3">Swipe over text to select it like a highlighter, or across a paragraph to take all of it.</string>
    <string name="home_usage_4">Circle anything to select it. Without text, the area is selected as an image.</string>
    <string name="home_usage_5">The handles move the start and end of the selection.</string>
    <string name="home_usage_6">Recognized QR codes and barcodes light up. Tap one to see its content and actions.</string>
    <string name="home_usage_7">Push the bar at the bottom up to see what it covers. Push it out at the top, or go back, to close Encircle.</string>
    <string name="home_try_title">Try it here</string>
    <string name="home_try_text">Encircle runs entirely on your device. It searches nothing online and sends no data anywhere. Try it on this paragraph: tap a word, swipe across it or circle it. Links like https://example.org and addresses like hello@example.org are recognized.</string>
    <string name="home_diagnostics_title">Last invocation</string>
    <string name="home_licenses">Encircle is free software under the Apache License 2.0, source code: github.com/Maxi2555/encircle. Barcodes: zxing-cpp (Apache-2.0). Text recognition: Google ML Kit (proprietary, offline on the device). Icons: Material Design Icons (Apache-2.0).</string>
    <string name="setup_title">Setup</string>
    <string name="setup_ready">Ready</string>
    <string name="setup_ready_summary">Encircle starts with your shortcut.</string>
    <plurals name="setup_steps_left">
        <item quantity="one">One step left</item>
        <item quantity="other">%d steps left</item>
    </plurals>
    <string name="setup_assistant_title">Choose Encircle as assistant</string>
    <string name="setup_assistant_text">Android only starts the digital assistant with a shortcut. Choose Encircle in the settings.</string>
    <string name="setup_assistant_disconnected">Encircle is selected, but Android signed it out when the device or this user started. In the settings, briefly choose “None” and then Encircle again.</string>
    <string name="setup_choose_assistant">Choose assistant</string>
    <string name="setup_reconnect">Reconnect</string>
    <string name="setup_fix_permanently">Fix permanently</string>
    <string name="setup_fix_text">Android signs Encircle out at every start of this user as long as no speech recognizer is set, and it never picks the one from Encircle by itself. Run this command once on a computer with adb, then reconnect:</string>
    <string name="setup_copy_command">Copy command</string>
    <string name="setup_screen_title">Allow screen content</string>
    <string name="setup_screen_text">On the same page, turn on “Use text from screen” and, where offered, “Use screenshot”. Without this, Encircle cannot see the screen.</string>
    <string name="setup_open_access">Allow access</string>
    <string name="setup_shortcut_title">Set up the shortcut</string>
    <string name="setup_prefer_buttons">Use button navigation instead</string>
    <string name="setup_try_hint">Try the shortcut now. As soon as Encircle starts through it, this step is done.</string>
    <string name="setup_try_in_app">Try in the app</string>
    <string name="try_failed_not_ready">Encircle is not ready yet. Try again in a moment.</string>
    <string name="try_failed_no_assistant">Encircle is no longer the active assistant</string>
    <string name="setup_done">Done</string>
    <string name="plan_buttons_title">Hold Home</string>
    <string name="plan_buttons_how">Press and hold the Home button and Encircle starts. If nothing happens, turn on “Hold Home to invoke assistant” in the button settings.</string>
    <string name="plan_buttons_button">Button settings</string>
    <string name="plan_buttons_pixel_how">Under Navigation mode, turn off “Circle to Search”. Then a long press on the Home button starts Encircle.</string>
    <string name="plan_buttons_samsung_how">Under Settings › Display › Navigation bar, turn off “Circle to Search”. Then a long press on the Home button starts Encircle.</string>
    <string name="plan_handle_title">Hold the navigation bar</string>
    <string name="plan_pixel_how">Under Navigation mode, turn off “Circle to Search”. Then a long press on the bar at the bottom starts Encircle. You can also swipe diagonally up from a bottom corner.</string>
    <string name="plan_pixel_button">Open navigation mode</string>
    <string name="plan_samsung_how">Under Settings › Display › Navigation bar, turn off “Circle to Search”. Then a long press on the bar starts Encircle.</string>
    <string name="plan_samsung_button">Display settings</string>
    <string name="plan_corner_title">Swipe from the corner</string>
    <string name="plan_corner_how">In the gesture settings, turn on “Swipe to invoke assistant”. Then a diagonal swipe up from a bottom corner starts Encircle. On this system, a long press on the bar is reserved for Google search.</string>
    <string name="plan_corner_button">Gesture settings</string>
