    <string name="onboarding_practice_text">Start Encircle now with your shortcut: %1$s. Then select the sentence below or tap the QR code.</string>
    <string name="onboarding_practice_sample">Read more about Encircle at encircle.example.org. Questions are welcome at hello@example.org.</string>
    <string name="onboarding_practice_done">It worked! Encircle starts with your shortcut.</string>
